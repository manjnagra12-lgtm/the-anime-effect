# Copy this file to .env for local development. Never put real credentials here.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Add provider-specific API credentials here only when an integration needs them.
# Example: ANIME_PROVIDER_API_KEY=replace-with-your-local-key
